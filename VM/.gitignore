# Build inputs and outputs. Everything here is regenerated by build.py, and the
# disk images are gigabytes.
xpkey.txt
node_modules/
__pycache__/
*.log
*.partial
.install-running

# Disk images, ISOs, and the staging tree they are built from. XPDrives is
# entirely build output.
*.img
*.iso
*.datepatch
Install/XPDrives/

# The savestate and the copy of the disk the page serves.
state.bin.zst
Viewer/xp.img

# Copied into Viewer/ from the installed v86 package by build.py, so the page and
# the capture can never be running different versions of the emulator.
Viewer/libv86.mjs
Viewer/v86.wasm
Viewer/bios/

# Third-party redistributables you supply yourself: the XP media, MySQL, .NET 4,
# the Crystal Reports runtime, the font. Several are already in the repository
# root, and none of them belong in it twice. See Install/Deps/README.md.
Install/Deps/*
!Install/Deps/README.md
